rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMemberOf(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isOwnerOf(householdId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/households/$(householdId)) &&
        get(/databases/$(database)/documents/households/$(householdId)).data.ownerId == request.auth.uid;
    }

    function userHouseholdId(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.get('householdId', '');
    }

    function sharesHouseholdWith(otherUserId) {
      let mine = userHouseholdId(request.auth.uid);
      return isAuthenticated() &&
        mine is string &&
        mine != '' &&
        mine == userHouseholdId(otherUserId);
    }

    function householdInviteMatches(householdId) {
      let code = get(/databases/$(database)/documents/households/$(householdId)).data.inviteCode;
      return code is string &&
        exists(/databases/$(database)/documents/inviteCodes/$(code)) &&
        get(/databases/$(database)/documents/inviteCodes/$(code)).data.householdId == householdId;
    }

    function onlyMemberCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        (
          request.resource.data.memberCount == resource.data.memberCount + 1 ||
          request.resource.data.memberCount == resource.data.memberCount - 1
        );
    }

    match /users/{userId} {
      allow get: if isUser(userId) || sharesHouseholdWith(userId);
      allow list: if false;
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.householdId is string &&
        request.resource.data.householdId != '' &&
        (
          isOwnerOf(request.resource.data.householdId) ||
          (existsAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)) &&
           getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == request.auth.uid) ||
          isMemberOf(request.resource.data.householdId)
        );
      allow update: if isAuthenticated() &&
        isOwnerOf(resource.data.householdId) &&
        request.resource.data.householdId == resource.data.householdId;
      allow delete: if isAuthenticated() && isOwnerOf(resource.data.householdId);
    }

    match /households/{householdId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOf(householdId) || (isAuthenticated() && onlyMemberCountChanged());
      allow delete: if isOwnerOf(householdId);

      match /members/{memberId} {
        allow read: if isMemberOf(householdId) || isUser(memberId);
        allow create, update: if isUser(memberId) || isOwnerOf(householdId);
        allow delete: if isUser(memberId) || isOwnerOf(householdId);
      }

      match /expenses/{expenseId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId) &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa > 0 &&
          request.resource.data.splitAmongIds is list &&
          request.resource.data.splitAmongIds.size() > 0;
        allow update, delete: if isMemberOf(householdId) &&
          (resource.data.createdByUserId == request.auth.uid || isOwnerOf(householdId));
      }

      match /settlements/{settlementId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId) &&
          request.resource.data.recordedByUserId == request.auth.uid &&
          request.resource.data.amountPaisa is int &&
          request.resource.data.amountPaisa > 0 &&
          request.resource.data.fromUserId != request.resource.data.toUserId;
        allow update: if false;
        allow delete: if isOwnerOf(householdId);
      }

      match /notifications/{notificationId} {
        allow read: if isMemberOf(householdId);
        allow create: if isMemberOf(householdId);
        allow update: if isMemberOf(householdId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUserIds']) &&
          request.auth.uid in request.resource.data.readByUserIds;
        allow delete: if isOwnerOf(householdId);
      }
    }
  }
}
